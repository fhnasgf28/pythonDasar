<odoo>
    <record id="view_move_form_inherit_ktt_sync" model="ir.ui.view">
        <field name="name">account.move.form.ktt.sync</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="x_sales_team_id"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="KTT Salespeople">
                    <field name="x_salesperson_line_ids">
                        <tree editable="bottom">
                            <field name="user_id"/>
                            <field name="weightage"/>
                            <field name="type"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
