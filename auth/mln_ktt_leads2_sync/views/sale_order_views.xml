<odoo>
    <record id="view_order_form_inherit_ktt_sync" model="ir.ui.view">
        <field name="name">sale.order.form.ktt.sync</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="x_ktt_leads2_id" readonly="1"/>
                <field name="x_sales_team_id"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="KTT Salespeople">
                    <field name="x_salesperson_line_ids">
                        <tree editable="bottom">
                            <field name="user_id"/>
                            <field name="weightage"/>
                            <field name="type"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
