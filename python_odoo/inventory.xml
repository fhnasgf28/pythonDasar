<record id="product_template_warranty" model="ir.actions.act_window">
			<field name="name">Product Template</field>
			<field name="res_model">product.template</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
				 <p class="oe_view_nocontent_create">
					Create a new product template.
				</p>
				<p>
					Product templates define the main attributes of a product,
					including pricing, warranty settings, and accounting information,
					before any variants are created.
				</p>
			</field>
		</record>

